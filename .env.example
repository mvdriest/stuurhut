# Supabase project URL en publishable key (Settings -> API in het dashboard).
SUPABASE_URL=
SUPABASE_KEY=

# Supabase service_role key (Settings -> API). Alleen server-side gebruikt,
# voor de single-account setup-check via de Supabase admin API. Nooit
# client-side blootstellen.
NUXT_SUPABASE_SECRET_KEY=

# Gemini API (voor AI-weekplanning)
NUXT_GEMINI_API_KEY=

NUXT_TELEGRAM_BOT_TOKEN=
