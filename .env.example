# Supabase project URL en publishable key (Settings -> API in het dashboard).
SUPABASE_URL=
SUPABASE_KEY=

# Supabase service_role key (Settings -> API). Alleen server-side gebruikt,
# voor de single-account setup-check via de Supabase admin API. Nooit
# client-side blootstellen.
NUXT_SUPABASE_SECRET_KEY=

# Gemini API (voor AI-weekplanning)
NUXT_GEMINI_API_KEY=

# Telegram-bot (snelle capture). Het webhook-secret is een zelfgekozen willekeurige
# string die je ook als secret_token bij setWebhook meegeeft; zonder geldige
# X-Telegram-Bot-Api-Secret-Token-header weigert /api/telegram/webhook elk verzoek.
NUXT_TELEGRAM_BOT_TOKEN=
NUXT_TELEGRAM_WEBHOOK_SECRET=
NUXT_TELEGRAM_ALLOWED_USER_ID=
